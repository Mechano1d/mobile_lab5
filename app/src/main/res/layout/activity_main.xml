<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Завантаження журналів"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="30dp" />

    <EditText
        android:id="@+id/etIssue1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Номер випуску 1"
        android:inputType="number"
        android:singleLine="true" />

    <EditText
        android:id="@+id/etIssue2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Номер випуску 2"
        android:inputType="number"
        android:singleLine="true" />

    <Button
        android:id="@+id/btnDownload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Завантажити"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Введіть номер випуску"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Дивитися"
        android:enabled="false" />

    <Button
        android:id="@+id/btnDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Видалити"
        android:enabled="false"
        android:layout_marginTop="8dp" />

</LinearLayout>